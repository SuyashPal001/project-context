# ─── Cognito ──────────────────────────────────────────────────────────────────
# Found in AWS Console → Cognito → User Pools → project-context-dev-user-pool
# Or from: terraform output (after terraform apply)
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Cognito hosted UI domain — format: https://{cognito_domain_prefix}.auth.{region}.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=https://project-context-dev.auth.ap-south-1.amazoncognito.com
# Must match one of the allowed callback URLs registered in Cognito (cognito_callback_urls in tfvars)
NEXT_PUBLIC_COGNITO_CALLBACK_URL=http://localhost:3000/auth/callback

# ─── API ──────────────────────────────────────────────────────────────────────
# Server-side only — used by the Next.js /api/proxy route to forward requests to Lambda API
# Dev: http://localhost:3000 (sam local) | Prod: API Gateway URL from terraform output
API_URL=http://localhost:3000
# Client-side — same URL, proxied through Next.js /api/proxy
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── WebSocket ────────────────────────────────────────────────────────────────
# API Gateway WebSocket endpoint — from terraform output (ws_api_endpoint SSM param)
# Dev: wss://{ws-api-id}.execute-api.ap-south-1.amazonaws.com/dev
NEXT_PUBLIC_WS_URL=

# ─── Agent / Relay ────────────────────────────────────────────────────────────
# Relay service WebSocket URL — used by Canvas and agent event hooks
# Dev: wss://localhost:3001 | Prod: wss://agent-orchestrator.projectcontext.co
NEXT_PUBLIC_AGENT_WS_URL=wss://agent-orchestrator.projectcontext.co

# ─── Domain ───────────────────────────────────────────────────────────────────
# Root domain for multi-tenant middleware routing
# Dev: localhost:3000 | Prod: projectcontext.co
NEXT_PUBLIC_ROOT_DOMAIN=projectcontext.co

# ─── Inference Gateway (server-side only) ─────────────────────────────────────
# Used by the ops observability route — defaults to localhost:4001 if not set
INFERENCE_GATEWAY_URL=http://localhost:4001
