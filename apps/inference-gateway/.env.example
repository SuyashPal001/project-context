PORT=4001

# --- Vertex AI (Gemini) ---
# Authentication is KEYLESS. On the GCP VM the gateway authenticates via the
# instance's attached service account (inference-gateway@<project>) using
# Application Default Credentials through the metadata server.
#
# Do NOT add GOOGLE_APPLICATION_CREDENTIALS or GCP_SA_KEY here.
# ADC resolves in this order:
#   1. GOOGLE_APPLICATION_CREDENTIALS  2. gcloud user creds  3. metadata server
# so setting either of those SILENTLY overrides the attached service account —
# the gateway keeps working while authenticating as something else entirely.
# Their absence is load-bearing, not an oversight.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# --- Fallback providers (used only if Vertex fails; see src/router.ts) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OpenRouter — used by OpenRouterAdapter for model-picker "openrouter/*" models.
# Unset by default; requests routed to it fail fast with a clear error until set.
OPENROUTER_API_KEY=

# Shared secret proving a caller is platform infrastructure. REQUIRED — this
# service refuses to start without it. Must match the value in
# project-context/{env}/internal-service-key (AWS Secrets Manager), which the
# Lambdas resolve at cold start.
INTERNAL_SERVICE_KEY=

# Interface to bind. Defaults to 127.0.0.1 — every caller runs on this VM, so
# listening on 0.0.0.0 would put billable inference one firewall rule away from
# the internet. Only set this if a genuinely remote caller is introduced.
INFERENCE_BIND_HOST=127.0.0.1
