PORT=3005
NODE_ENV=development

# Database — Docker Postgres (local) or Neon URL (prod)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/project_context

# Redis — use redis:// for local dev, https:// Upstash URL for prod
UPSTASH_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=          # Required for Upstash (prod); leave empty for local redis://

# Auth — fill from Cognito after terraform apply
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=ap-south-1

# Internal service keys
INTERNAL_SERVICE_KEY=local-dev-service-key
TOKEN_ENCRYPTION_KEY=local-dev-encryption-key-32chars!!

# Agent orchestrator
AGENT_ORCHESTRATOR_URL=http://localhost:3001
AGENT_ORCHESTRATOR_INTERNAL_URL=http://localhost:3001

# SQS — comes from SAM deploy via SSM in prod; optional in local dev (usage recording skipped if unset)
SQS_PROCESSING_QUEUE_URL=
AGENT_TASK_QUEUE_URL=

# Email — SES sender address; comes from SAM/SSM in prod
FROM_EMAIL=

# S3 — documents bucket; comes from SAM/SSM in prod
DOCUMENTS_BUCKET=

# Google OAuth — comes from Secrets Manager in prod (terraform-managed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Zoho OAuth — comes from Secrets Manager in prod
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=

# Jira OAuth — comes from Secrets Manager in prod
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# Shared self-hosted Nango instance — Gmail only (see
# docs/superpowers/specs/2026-08-11-nango-gmail-migration-design.md).
NANGO_HOST=
NANGO_SECRET_KEY_PROJECT_CONTEXT=
NANGO_WEBHOOK_SECRET=
