# Database
DATABASE_URL=           # Neon PostgreSQL connection string

# Google OAuth — GCP Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token encryption — openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Shared secret proving a caller is platform infrastructure. REQUIRED — this
# service refuses to start without it. Must match the value in
# project-context/{env}/internal-service-key (AWS Secrets Manager), which the
# Lambdas resolve at cold start.
INTERNAL_SERVICE_KEY=

# Interface to bind. Defaults to 127.0.0.1 — this service resolves tenant Gmail
# credentials and should not be reachable off-host.
MCP_BIND_HOST=127.0.0.1

# Agent orchestrator base URL. Used to request human approval for tool calls
# the policy guard flags as requiresApproval (POST /mcp/approval-request).
# Same-host on the VM by default — see CLAUDE.md's service port table.
AGENT_ORCHESTRATOR_URL=http://localhost:3001

# Shared self-hosted Nango instance — Gmail tokens only (see
# docs/superpowers/specs/2026-08-11-nango-gmail-migration-design.md).
NANGO_HOST=
NANGO_SECRET_KEY_PROJECT_CONTEXT=
