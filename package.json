{
  "name": "serverless-saas",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-tenant SaaS foundation",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "clean": "find . -name 'dist' -type d -not -path '*/node_modules/*' -exec rm -rf {} + && find . -name 'tsconfig.tsbuildinfo' -delete",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "pnpm -r run type-check",
    "format": "prettier --write \"**/*.{ts,json,yaml,md}\"",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "pnpm -r run --if-present test"
  },
  "dependencies": {
    "mammoth": "^1.7.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.5.8",
      "pg": "8.23.0",
      "ai": "6.0.276",
      "@ai-sdk/provider": "3.0.15"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@ai-sdk/google-vertex>zod": ">=3",
        "@ai-sdk/provider-utils>zod": ">=3",
        "@ai-sdk/react>zod": ">=3",
        "@ai-sdk/ui-utils>zod": ">=3",
        "ai>zod": ">=3"
      }
    }
  }
}
