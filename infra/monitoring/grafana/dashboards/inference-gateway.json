{
  "title": "Inference Gateway",
  "uid": "inference-gateway",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / min by adapter",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(inference_gateway_requests_total{status=\"success\"}[1m]) * 60",
          "legendFormat": "{{adapter}} success"
        },
        {
          "expr": "rate(inference_gateway_requests_total{status=\"failure\"}[1m]) * 60",
          "legendFormat": "{{adapter}} failure"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm", "min": 0 }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fallbacks / min",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(inference_gateway_fallbacks_total[1m]) * 60",
          "legendFormat": "{{from}} → {{to}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm", "min": 0, "color": { "fixedColor": "orange", "mode": "fixed" } }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Circuit — Vertex",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "targets": [
        { "expr": "inference_gateway_circuit_state{adapter=\"vertex\"}", "legendFormat": "" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" }, "1": { "text": "HALF-OPEN", "color": "yellow" }, "2": { "text": "OPEN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 } ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Circuit — Anthropic",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "targets": [
        { "expr": "inference_gateway_circuit_state{adapter=\"anthropic\"}", "legendFormat": "" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" }, "1": { "text": "HALF-OPEN", "color": "yellow" }, "2": { "text": "OPEN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 } ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Circuit — Ollama",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 },
      "targets": [
        { "expr": "inference_gateway_circuit_state{adapter=\"ollama\"}", "legendFormat": "" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" }, "1": { "text": "HALF-OPEN", "color": "yellow" }, "2": { "text": "OPEN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 } ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Avg latency by adapter (ms)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 4 },
      "targets": [
        { "expr": "inference_gateway_request_duration_avg_ms", "legendFormat": "{{adapter}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0 }
      }
    }
  ]
}
