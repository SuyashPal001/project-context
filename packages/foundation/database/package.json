{
  "name": "@serverless-saas/database",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/*": {
      "types": "./dist/schema/*.d.ts",
      "default": "./dist/schema/*.js"
    },
    "./notification-workflows": {
      "types": "./dist/notification-workflows.d.ts",
      "default": "./dist/notification-workflows.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx seeds/index.ts",
    "index:knowledge": "tsx scripts/indexKnowledge.ts",
    "index:knowledge:dry": "tsx scripts/indexKnowledge.ts --dry-run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.2",
    "glob": "^11.0.0",
    "postgres": "^3.4.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.9.3"
  }
}